  "panels": [
    {
      "type": "row",
      "id": 10,
      "title": "System Units",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "id": 11,
      "title": "System Units — доступность сервисов",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource_pg}"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${datasource_pg}"
          },
          "rawSql": "SELECT\n  \"Компонент\",\n  \"сервер\",\n  \"Наименование unit\"\nFROM cmdb.services\nWHERE\n  \"ИТ-система\" = '${it_system}'\n  AND \"Тип unit\" = 'system unit'\n  AND (\n    '${affects_users}' = 'Все'\n    OR \"Влияет на пользователей\" = '${affects_users}'\n  )\n  AND (\n    '${affects_core}' = 'Все'\n    OR \"Влияет на основную функциональность\" = '${affects_core}'\n  )\nORDER BY \"Компонент\", \"сервер\", \"Наименование unit\"",
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prom}"
          },
          "expr": "label_replace(count_over_time((node_systemd_unit_state{instance=~\".+:10000\",state=\"active\"} == 1)[$__range:10s]) * 10,\"server\",\"$1\",\"instance\",\"(.+):.+\")",
          "instant": true,
          "format": "table",
          "refId": "B",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prom}"
          },
          "expr": "label_replace(count_over_time((node_systemd_unit_state{instance=~\".+:10000\",state=\"active\"} == 0)[$__range:10s]) * 10,\"server\",\"$1\",\"instance\",\"(.+):.+\")",
          "instant": true,
          "format": "table",
          "refId": "C",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prom}"
          },
          "expr": "label_replace((count_over_time((node_systemd_unit_state{instance=~\".+:10000\",state=\"active\"} == 1)[$__range:10s]) / count_over_time(node_systemd_unit_state{instance=~\".+:10000\",state=\"active\"}[$__range:10s])) * 100,\"server\",\"$1\",\"instance\",\"(.+):.+\")",
          "instant": true,
          "format": "table",
          "refId": "D",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "Value #B",
            "renamePattern": "Доступность (s)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "Value #C",
            "renamePattern": "Даунтайм (s)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "Value #D",
            "renamePattern": "Доступность (%)"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "state": true,
              "device": true,
              "fstype": true,
              "server": true
            },
            "indexByName": {
              "Компонент": 0,
              "сервер": 1,
              "Наименование unit": 2,
              "Доступность (s)": 3,
              "Даунтайм (s)": 4,
              "Доступность (%)": 5
            },
            "renameByName": {
              "name": "Наименование unit",
              "mountpoint": "Наименование unit"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "mean"
          ],
          "fields": [
            "Доступность (s)",
            "Даунтайм (s)",
            "Доступность (%)"
          ],
          "enablePagination": false,
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Доступность (%)",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Доступность (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
