import ldap
import sys

# Явно устанавливаем параметры TLS
ldap.set_option(ldap.OPT_X_TLS_CACERTFILE, "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem")
ldap.set_option(ldap.OPT_X_TLS_REQUIRE_CERT, ldap.OPT_X_TLS_ALLOW)
ldap.set_option(ldap.OPT_DEBUG_LEVEL, 255)  # Максимальный debug

print("Connecting to ldaps://10.50.24.45:3269")

try:
    conn = ldap.initialize("ldaps://10.50.24.45:3269")
    conn.set_option(ldap.OPT_X_TLS_CACERTFILE, "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem")
    conn.set_option(ldap.OPT_X_TLS_REQUIRE_CERT, ldap.OPT_X_TLS_ALLOW)
    
    # Попробуй простой bind (подставь реальные данные)
    # Если нет bind user - просто проверь соединение
    result = conn.simple_bind_s("", "")  # Anonymous bind
    print("SUCCESS: TLS connection established!")
    print(f"Result: {result}")
    
except ldap.SERVER_DOWN as e:
    print(f"ERROR: Server down or TLS failed: {e}")
    sys.exit(1)
except Exception as e:
    print(f"ERROR: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
